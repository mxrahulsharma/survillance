# Server settings for docker-compose.yml. Copy to .env and fill in (never share .env).

# the server's name, e.g. officeeye.duckdns.org (https certificate is made for it)
DOMAIN=yourname.duckdns.org

# who serves https:
#   caddy  = this project's own Caddy on ports 80/443 (an empty server)
#   apache = the server already runs Apache on 80/443 (other websites):
#            Apache forwards DOMAIN to the app on 127.0.0.1:APP_PORT
PROXY=caddy
APP_PORT=8800

# ---- OfficeEye (cameras, detections) at /
# the login of the website, and the token the office PC pushes with
# (office PC: Settings -> Cloud view -> Copy)
OFFICEEYE_USER=admin
OFFICEEYE_PASSWORD=change-me
# optional edit login: with it, the login above only looks (View), and changes
# (OfficeEye settings, attendance employees/entries/settings) ask for this one.
# Leave the password empty for one login that does everything.
OFFICEEYE_EDIT_USER=editor
OFFICEEYE_EDIT_PASSWORD=
OFFICEEYE_PUSH_TOKEN=change-me
OFFICEEYE_SECRET=change-me-to-a-long-random-string

# ---- NetraAttend (attendance) at /attendance
# one MongoDB database for both: the link ends in the database name (office_eye)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/office_eye
NETRA_SECRET_KEY=change-me-to-a-long-random-string
NETRA_ADMIN_USER=admin
NETRA_ADMIN_PASSWORD=change-me
# admin pages from the internet (protected by the admin password above)
NETRA_ADMIN_LAN_ONLY=False
